package org.firstinspires.ftc.teamcode;

import static com.qualcomm.robotcore.hardware.DcMotor.ZeroPowerBehavior.BRAKE;

import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.PIDFCoefficients;
import com.qualcomm.robotcore.util.ElapsedTime;


@TeleOp(name = "VoltsStarterBotTeleop", group = "VoltsStarterBotTeleop")
//@Disabled
public class VoltsStarterBotTeleop extends OpMode {

    // initializes all motors
    private DcMotor leftDrive = null;
    private DcMotor rightDrive = null;
    private DcMotorEx launcher = null;
    private CRServo leftFeeder = null;
    private CRServo rightFeeder = null;
    private CRServo windmill = null;
    private DcMotor intake = null;

    // used for setting power sent to drive train left and right
    double leftPower;
    double rightPower;
    

    /*
     * Code to run ONCE when the driver hits INIT
     */
    @Override
    public void init() {
        // This process helps with "Hardware Mapping"
        // This connects the physical motors in the real world with 
        // a software object that refers to that motor.
        // The phrase in quotes must match the phrase in the Configure Robot mapping

        leftDrive = hardwareMap.get(DcMotor.class, "left_drive");
        rightDrive = hardwareMap.get(DcMotor.class, "right_drive");
        launcher = hardwareMap.get(DcMotorEx.class, "launcher");
        leftFeeder = hardwareMap.get(CRServo.class, "left_feeder");
        rightFeeder = hardwareMap.get(CRServo.class, "right_feeder");
        intake = hardwareMap.get(DcMotor.class, "intake");
        windmill = hardwareMap.get(CRServo.class, "windmill");


        // Keeping motors in brake mode is good practice on init
        // This ensures that our motors start out in a predictable and safe mode on match start

        leftDrive.setZeroPowerBehavior(BRAKE);
        rightDrive.setZeroPowerBehavior(BRAKE);
        launcher.setZeroPowerBehavior(BRAKE);
        intake.setZeroPowerBehavior(BRAKE);

        //This ensures that our servos start in a predictable and safe mode on match start
        leftFeeder.setPower(0);
        rightFeeder.setPower(0);
        windmill.setPower(0);

        /* Because we physically flipped one of the motors in the robot
        we need to reverse the direction of one of the drivetrain motors
        We can use .setDirection() to do this!
        You must use either REVERSE or FORWARD in the parentheses to set the direction
        */
        //clockwise is considered forward

        leftDrive.setDirection(DcMotor.Direction.REVERSE);
        //Add that here!


        /* Because we want our two intake servos to both spin towards the 
        center of the robot, we need to reverse the direction of one of the servos
        we can use .setDirection() to do this
        You must use either REVERSE or FORWARD in the parentheses to set the direction
        */
        //clockwise is considered forward

        //Add that here!!

        leftFeeder.setDirection(DcMotor.Direction.REVERSE);

    }

    /*
     * Code to run REPEATEDLY after the driver hits INIT, but before they hit START
     */
    @Override
    public void init_loop() {
    }

    /*
     * Code to run ONCE when the driver hits START
     */
    @Override
    public void start() {
    }

    /*
     * Code to run REPEATEDLY after the driver hits START but before they hit STOP
     */
    @Override
    public void loop() {
    
        // Call to arcade drive
        // Use left joystick x axis for turning (left and right)
        // Use left joystick y axis for forward and backward
        // We can get the values from the left joystick x axis through:
        // gamepad1.left_stick_x
        // We can get the values from the left joystick y axis through:
        // gamepad1.left_stick_y
        // We want to set the power sent to the motors equal to the controller values


        double denominator = Math.max(1,(Math.abs(gamepad1.left_stick_y)+Math.abs(gamepad1.left_stick_x)));

        leftPower = gamepad1.left_stick_y + gamepad1.left_stick_x;
        rightPower = gamepad1.left_stick_y - gamepad1.left_stick_x;

        leftDrive.setPower(leftPower/denominator);
        rightDrive.setPower(rightPower/denominator);

        // launcher
        if(gamepad1.right_trigger>0.5){
            launcher.setPower(.45);
        }else{
            launcher.setPower(0);
        }
        //windmill
        if(gamepad1.right_trigger>0.5){
            windmill.setPower(1);
        }else{
            windmill.setPower(0);
        }

        if(gamepad1.left_trigger>.5){
            intake.setPower(.75);
            leftFeeder.setPower(1);
            rightFeeder.setPower(1);
        }else{
            intake.setPower(0);
            leftFeeder.setPower(0);
            rightFeeder.setPower(0);
        }

    }

    /*
     * Code to run ONCE after the driver hits STOP
     */
    @Override
    public void stop() {
    }

    // takes in 
    void arcadeDrive(double surge, double rotate) {
    }

}
